@page "/confirmation"

<PageTitle>Pedido Confirmado - BTFS</PageTitle>

<div class="confirmation-page container section text-center">
    <div class="confirmation-card animate-scale-in">
        <div class="confirmation-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        
        <h1 class="confirmation-title">Pedido Confirmado!</h1>
        <p class="confirmation-text">
            Sua compra foi processada com sucesso. O número do seu pedido é 
            <strong>#@OrderId</strong>.
        </p>
        <p class="confirmation-subtext">
            Enviamos os detalhes e os ingressos para o seu e-mail.
        </p>

        <div class="confirmation-actions">
            <a href="/" class="btn btn--primary btn--lg">Explorar mais eventos</a>
        </div>
    </div>
</div>

@code {
    private string OrderId { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        // Gerar um número de pedido aleatório para simulação
        var random = new Random();
        OrderId = $"BTFS-{random.Next(10000, 99999)}";
    }
}
