@using Btfs.Models
@using Btfs.Services

<!--
  EventCard – card de evento para grid de descoberta.

  DECISÃO UX:
  A imagem ocupa a parte superior e o gradiente escurece de baixo para cima,
  garantindo legibilidade do texto mesmo sobre fotos coloridas.
  O botão "Ver detalhes" aparece no hover (micro-interação que dá sensação premium).
-->
<article class="event-card @CssClass" aria-label="@Event.Title">
    <a href="/event/@Event.Id" class="event-card__link" tabindex="-1" aria-hidden="true">
        <!-- Imagem de capa -->
        <div class="event-card__image-wrapper">
            <img
                src="@Event.CoverImageUrl"
                alt="Imagem do evento @Event.Title"
                class="event-card__image"
                loading="lazy" />

            <!-- Gradiente sobre a imagem -->
            <div class="event-card__image-overlay" aria-hidden="true"></div>

            <!-- Badges sobre a imagem -->
            <div class="event-card__badges">
                @if (Event.IsOnline)
                {
                    <span class="badge badge--primary">🌐 Online</span>
                }
                @if (Event.IsCancelled)
                {
                    <span class="badge badge--error">Cancelado</span>
                }
                @foreach (var cat in Event.Categories.Take(1))
                {
                    <span class="badge badge--muted">@cat.Icon @cat.Name</span>
                }
            </div>

            <!-- Data flutuante no canto -->
            <div class="event-card__date-badge" aria-label="Data do evento">
                <span class="event-card__date-day">@Event.StartDate.Day</span>
                <span class="event-card__date-month">
                    @Event.StartDate.ToString("MMM", new System.Globalization.CultureInfo("pt-BR"))
                </span>
            </div>
        </div>
    </a>

    <!-- Corpo do card -->
    <div class="event-card__body">
        <a href="/event/@Event.Id" class="event-card__title-link">
            <h3 class="event-card__title">@Event.Title</h3>
        </a>

        <div class="event-card__meta">
            <p class="event-card__info">
                <span aria-hidden="true">📍</span>
                <span>
                    @if (Event.IsOnline)
                    {
                        <text>Evento Online</text>
                    }
                    else if (Event.Location != null)
                    {
                        <text>@Event.Location.DisplayLocation</text>
                    }
                </span>
            </p>
            <p class="event-card__info">
                <span aria-hidden="true">🕐</span>
                <time datetime="@Event.StartDate.ToString("yyyy-MM-ddTHH:mm")">
                    @Event.DateDisplay
                </time>
            </p>
        </div>

        <div class="event-card__footer">
            <div class="event-card__price">
                <span class="event-card__price-label">a partir de</span>
                <strong class="event-card__price-value">@Event.PriceDisplay</strong>
            </div>

            <a href="/event/@Event.Id"
               class="btn btn--primary btn--sm event-card__cta"
               aria-label="Ver detalhes de @Event.Title">
                Ver detalhes
            </a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Event Event { get; set; } = default!;
    [Parameter] public string CssClass { get; set; } = "";
}
