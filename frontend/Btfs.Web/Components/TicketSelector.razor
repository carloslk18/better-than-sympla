@inject CartService Cart

<!--
  TicketSelector – Componente responsável por exibir os lotes (TicketTypes)
  e permitir que o usuário escolha a quantidade de ingressos.
-->
<div class="ticket-selector">
    <h3 class="ticket-selector__title">Ingressos</h3>

    @if (TicketTypes == null || !TicketTypes.Any())
    {
        <div class="alert alert--warning">
            Nenhum lote disponível no momento.
        </div>
    }
    else
    {
        <div class="ticket-list">
            @foreach (var ticket in TicketTypes)
            {
                var qty = Cart.GetQuantity(ticket.Id);
                var isSoldOut = ticket.QuantityAvailable <= 0;
                var isSalesEnded = ticket.SalesEndDate < DateTime.Now;
                var isUnavailable = isSoldOut || isSalesEnded;

                <div class="ticket-item @(isUnavailable ? "ticket-item--unavailable" : "")">
                    <div class="ticket-item__info">
                        <h4 class="ticket-item__name">@ticket.Name</h4>
                        <div class="ticket-item__price">
                            @if (ticket.Price == 0)
                            {
                                <span>Gratuito</span>
                            }
                            else
                            {
                                <span>R$ @ticket.Price.ToString("N2")</span>
                            }
                        </div>
                        @if (isSalesEnded)
                        {
                            <span class="ticket-item__meta text-error">Vendas encerradas</span>
                        }
                        else if (isSoldOut)
                        {
                            <span class="ticket-item__meta text-warning">Esgotado</span>
                        }
                        else
                        {
                            <span class="ticket-item__meta">Lote vira em @ticket.SalesEndDate.ToString("dd/MM")</span>
                        }
                    </div>

                    <div class="ticket-item__actions">
                        @if (isUnavailable)
                        {
                            <span class="badge badge--muted">Indisponível</span>
                        }
                        else
                        {
                            <div class="qty-control">
                                <button class="qty-btn" @onclick="() => UpdateQuantity(ticket, qty - 1)" disabled="@(qty <= 0)" aria-label="Diminuir quantidade">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                                <span class="qty-value" aria-live="polite">@qty</span>
                                <button class="qty-btn" @onclick="() => UpdateQuantity(ticket, qty + 1)" disabled="@(qty >= 10)" aria-label="Aumentar quantidade">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<TicketType> TicketTypes { get; set; } = [];

    // O CartService já é singleton-scoped e mantém o estado.
    // Usamos o evento OnChange para forçar re-render se o carrinho for atualizado
    // por outra parte do app, embora neste contexto o controle seja local.
    protected override void OnInitialized()
    {
        Cart.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
    }

    private void UpdateQuantity(TicketType ticket, int newQty)
    {
        if (newQty >= 0 && newQty <= 10)
        {
            Cart.AddOrUpdate(ticket, newQty);
        }
    }
}
