@inherits LayoutComponentBase

<!--
  MainLayout: estrutura de página global.
  - NavMenu no topo (sticky)
  - @Body = conteúdo da página atual renderizado aqui
  - Sem sidebar: o BTFS é um marketplace, então layout de largura total faz sentido.
-->
<NavMenu />

<main class="main-content">
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__inner">
            <div class="site-footer__brand">
                <span class="brand-logo">BTFS</span>
                <p class="site-footer__tagline">Descubra eventos incríveis perto de você.</p>
            </div>
            <nav class="site-footer__links" aria-label="Links do rodapé">
                <a href="/">Explorar</a>
                <a href="#">Para Organizadores</a>
                <a href="#">Suporte</a>
                <a href="#">Termos</a>
            </nav>
        </div>
        <div class="site-footer__bottom">
            <p>&copy; @DateTime.Now.Year BTFS. Feito com ♥ no Brasil.</p>
        </div>
    </div>
</footer>
